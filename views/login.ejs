<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate icon" href="/favicon.ico">
  <title>
    <%= title %>
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/login-page.css">
  <style>
    .dynamic-text-wrapper {
      flex: 1;
      min-width: 0;
      margin: 0 1rem;
      display: block;
      height: 30px;
      line-height: 30px;
      overflow: hidden;
      cursor: default;
    }

    .nav-ticker {
      display: inline-block;
      white-space: nowrap;
      will-change: transform;
      backface-visibility: hidden;
      animation: navTickerMarquee 25s linear infinite;
    }

    .nav-ticker:hover {
      animation-play-state: paused;
    }

    .nav-ticker-text {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      font-weight: 500;
      text-transform: uppercase;
      background: linear-gradient(90deg, #e0e7ff, #a5b4fc, #c4b5fd, #e0e7ff);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: navTextShimmer 4s linear infinite;
      display: inline-block;
      padding-right: 1.5rem;
      letter-spacing: 0.12em;
    }

    .nav-separator {
      display: inline-block;
      color: rgba(165, 180, 252, 0.3);
      font-weight: 300;
      font-size: 0.85rem;
      padding: 0 0.8rem;
      -webkit-text-fill-color: rgba(165, 180, 252, 0.3);
    }

    @keyframes navTextShimmer {
      0% { background-position: 0% center; }
      100% { background-position: 200% center; }
    }

    @keyframes navTickerMarquee {
      0% {
        transform: translate3d(0, 0, 0);
      }

      100% {
        transform: translate3d(-50%, 0, 0);
      }
    }

    @media (max-width: 768px) {
      .login-page .navbar {
        flex-wrap: nowrap;
        align-items: center;
        gap: 0.5rem;
      }

      .login-page .logo-brand {
        flex-shrink: 0;
        min-width: 0;
        gap: 0.45rem;
      }

      .login-page .logo-text {
        font-size: 0.875rem;
        white-space: nowrap;
      }

      .dynamic-text-wrapper {
        flex: 1 1 auto;
        min-width: 0;
        order: unset;
        margin: 0;
        height: 1.375rem;
        line-height: 1.375rem;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
      }

      .nav-ticker {
        animation-duration: 32s;
      }

      .nav-ticker-text {
        font-size: 0.5625rem;
        letter-spacing: 0.08em;
        padding-right: 0.75rem;
      }

      .nav-separator {
        font-size: 0.5625rem;
        padding: 0 0.35rem;
      }
    }

    @media (max-width: 380px) {
      .login-page .logo-text {
        font-size: 0.8125rem;
      }

      .nav-ticker-text {
        font-size: 0.5rem;
        letter-spacing: 0.06em;
      }
    }
  </style>
</head>

<body class="login-page">

  <div class="navbar-wrapper">
    <div class="navbar-glass">
      <nav class="navbar" aria-label="Primary">
        <a href="/" class="logo-brand">
          <div class="logo-icon-box">
            <svg class="logo-house-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="logo-text">GROW<span class="logo-dot">.AI</span></span>
        </a>

        <div id="dynamic-nav-text-container" class="dynamic-text-wrapper" title="Pause animation on hover">
            <div class="nav-ticker">
                <span class="nav-ticker-text">Turn your resume into an opportunity magnet.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Analyze. Improve. Get Hired.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Your dream job starts with a better resume.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Smart insights. Stronger resumes. Better careers.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Upgrade your resume. Unlock your future.</span><span class="nav-separator">/</span>
                <span class="nav-ticker-text">Turn your resume into an opportunity magnet.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Analyze. Improve. Get Hired.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Your dream job starts with a better resume.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Smart insights. Stronger resumes. Better careers.</span><span class="nav-separator">/</span><span class="nav-ticker-text">Upgrade your resume. Unlock your future.</span><span class="nav-separator">/</span>
            </div>
        </div>
      </nav>
    </div>
  </div>

  <section class="hero-section" aria-labelledby="landing-headline">
    <div class="hero-content">
      <h1 class="hero-headline" id="landing-headline">Grow</h1>
      <p class="hero-subtext">
        Analyze · Match · Elevate
      </p>
      <div class="hero-cta">
        <a href="/dashboard" class="cta-button">Analyze Your Resume</a>
      </div>
    </div>
  </section>

  <section class="social-proof" aria-hidden="false">
    <video id="bgVideo" class="video-bg" autoplay muted playsinline>
      <source
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260308_114720_3dabeb9e-2c39-4907-b747-bc3544e2d5b7.mp4"
        type="video/mp4">
    </video>
    <div class="gradient-overlay"></div>
    <div class="social-content">
      <div class="video-spacer"></div>
      <div class="marquee-container">
        <div class="marquee-label">
          Relied on by brands<br>
          across the globe
        </div>
        <div class="marquee-wrapper">
          <div class="marquee-track" id="marqueeTrack"></div>
        </div>
      </div>
    </div>
  </section>

  <script src="/js/site-perf.js"></script>
  <script>
    (function () {
      var brands = ['Vortex', 'Nimbus', 'Prysma', 'Cirrus', 'Kynder', 'Halcyn'];

      function createLogoItem(name) {
        return (
          '<div class="logo-item">' +
          '<div class="logo-icon liquid-glass"><span>' + name[0] + '</span></div>' +
          '<span class="logo-name">' + name + '</span>' +
          '</div>'
        );
      }

      var marqueeTrack = document.getElementById('marqueeTrack');
      if (marqueeTrack) {
        var allBrands = brands.concat(brands);
        marqueeTrack.innerHTML = allBrands.map(createLogoItem).join('');
      }

      if (window.GrowSitePerf) {
        window.GrowSitePerf.initVisibilityPause(['.nav-ticker', '.marquee-track', '.nav-ticker-text']);
      }

      var video = document.getElementById('bgVideo');
      if (!video) return;

      var fadeDuration = 0.5;

      function updateVideoOpacity() {
        if (!video.duration) return;
        var currentTime = video.currentTime;
        var duration = video.duration;
        var opacity = 1;
        if (currentTime < fadeDuration) {
          opacity = currentTime / fadeDuration;
        } else if (currentTime > duration - fadeDuration) {
          var remaining = duration - currentTime;
          opacity = remaining / fadeDuration;
        }
        video.style.opacity = String(opacity);
      }

      function onTimeUpdate() {
        if (!video.duration) return;
        var currentTime = video.currentTime;
        var duration = video.duration;
        if (currentTime < fadeDuration || currentTime > duration - fadeDuration) {
          updateVideoOpacity();
        } else if (video.style.opacity !== '1') {
          video.style.opacity = '1';
        }
      }

      video.addEventListener('timeupdate', onTimeUpdate, { passive: true });
      video.addEventListener('seeked', updateVideoOpacity, { passive: true });

      video.addEventListener('ended', function () {
        video.style.opacity = '0';
        setTimeout(function () {
          video.currentTime = 0;
          video.play();
        }, 100);
      });

      video.addEventListener('loadedmetadata', updateVideoOpacity, { passive: true });

      if (video.readyState >= 2) {
        updateVideoOpacity();
      }

    })();
  </script>
</body>

</html>