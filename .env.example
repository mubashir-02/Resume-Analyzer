# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Adzuna API Credentials
# Get yours at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Server Port
PORT=3000

# Cloudinary — resume PDF storage (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional folder inside Cloudinary (default: grow-ai/resumes)
# CLOUDINARY_FOLDER=grow-ai/resumes

# LOCAL DEV ONLY — fixes "unable to verify the first certificate" on some Windows machines.
# Do NOT set this on Vercel, Railway, Render, or any production host (omit the variable entirely).
# SSL_INSECURE_DEV=true
